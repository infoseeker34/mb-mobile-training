# Magic Board Training — Environment Variables
# Copy this file to .env and fill in values for local development.
# NEVER commit .env to git. All secrets go in EAS Secrets for CI/CD builds.

# API
API_BASE_URL=http://localhost:3050

# AWS Cognito OAuth
COGNITO_DOMAIN=magic-board-dev-auth.auth.us-east-1.amazoncognito.com
COGNITO_USER_POOL_ID=us-east-1_4CSKmyoGw
COGNITO_CLIENT_ID=your_cognito_client_id_here
COGNITO_REDIRECT_URI=mbtraining://auth

# App Environment: development | staging | production
APP_ENV=development

# Sentry (leave blank for local dev)
SENTRY_DSN=
